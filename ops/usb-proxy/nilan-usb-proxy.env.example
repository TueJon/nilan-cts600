# Copy to /etc/default/nilan-usb-proxy and edit for the host.
# The alias is optional. Configure it only if the primary server expects a
# stable bridge IP and DHCP cannot provide a stable lease. Check for collisions.
NILAN_USB_DEVICE=/dev/serial/by-id/usb-REPLACE_WITH_STABLE_DEVICE_ID
NILAN_USB_BAUD=115200
NILAN_USB_BIND=192.0.2.30
NILAN_USB_PORT=6638
NILAN_USB_ALLOW_CIDRS=192.0.2.50/32
NILAN_USB_STATUS_SECONDS=60

# Leave both empty to avoid managing network addresses. When enabled, use the
# exact free address and interface intended for this host only.
NILAN_USB_ALIAS=
NILAN_USB_ALIAS_INTERFACE=
