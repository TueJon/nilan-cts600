# Copy to env/nilan.env and fill in. (env/nilan.env is gitignored — holds secrets.)

# --- Device mode -------------------------------------------------------------
# 1 = mockup (no hardware, frodef CTS600Mockup) — use until the ESP bridge is live.
# 0 = real device via socat tunnel (requires ESP_IP below).
NILAN_MOCKUP=1

# ESP32 bridge endpoint (set once Wattson reports the live/static IP from TUE-16).
ESP_IP=
ESP_PORT=6638
# Optional second transport (for example a USB serial proxy). It is tried only
# after the primary TCP stream closes, so both transports never own the UART at
# the same time. Use a separate, stable address reserved for this endpoint.
ESP_FALLBACK_IP=
ESP_FALLBACK_PORT=6638

NILAN_PORT=/dev/ttyNILAN
NILAN_RETRIES=3
NILAN_POLL_SECONDS=30
# Physical readiness requires all mapped sensor fields plus unit status from a
# successful poll within this age. Defaults to max(90s, 3 polling intervals).
NILAN_HEALTH_STALE_SECONDS=90
# Rotate the active raw TCP tunnel after prolonged missing/invalid physical polls.
# The request is a private atomic marker shared by API and tunnel supervisor.
NILAN_TUNNEL_RECOVERY_FILE=/run/nilan-tunnel-recover
NILAN_TUNNEL_RECOVERY_THRESHOLD_SECONDS=60
NILAN_TUNNEL_RECOVERY_COOLDOWN_SECONDS=180
NILAN_T15_FALLBACK=21
# Max age (seconds) of a live room temperature (POST /api/room, MQTT room/set) before
# falling back to NILAN_T15_FALLBACK. 0 = disable live values entirely.
NILAN_ROOM_TTL_SECONDS=900
NILAN_ACTIVITY_LOG_MAX=300
NILAN_ACTIVITY_READ_SUMMARY_SECONDS=60
NILAN_ACTIVITY_READ_SUMMARY_COUNT=10

# Provisional sensor->contract mapping; confirm against the unit nameplate (TUE-16 §11).
NILAN_T_ROOM_KEY=T15
NILAN_T_SUPPLY_KEY=T1
NILAN_T_EXHAUST_KEY=T5

# --- HTTP --------------------------------------------------------------------
NILAN_HTTP_HOST=0.0.0.0
NILAN_HTTP_PORT=8642
# Optional bearer token for direct API access (auth is primarily at the Caddy proxy).
NILAN_API_TOKEN=

# --- MQTT --------------------------------------------------------------------
# MQTT_HOST is injected as "mosquitto" by docker-compose. For host runs set it here.
MQTT_PORT=1883
MQTT_USER=nilan
MQTT_PASS=CHANGE_ME
MQTT_BASE_TOPIC=nilan
